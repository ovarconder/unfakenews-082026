// ============================================================
// Translation Manager — Admin Dashboard
// ============================================================
// หน้าจัดการระบบแปลภาษา 15 ภาษา
// - แสดงสถานะการแปลของทุกบทความ ทุกภาษา
// - Trigger การแปลใหม่ (pre-translate)
// - แสดงค่าใช้จ่ายโดยประมาณ (Dry Run)
// - ปุ่ม "Translate Now" สำหรับแต่ละบทความ
// ============================================================

"use client";

import { useState, useEffect } from "react";
import { getAllArticleMasters } from "@/lib/articles-data";
import type { ArticleMaster } from "@/lib/types";
import { ALL_LOCALES, LOCALE_NAMES } from "@/lib/locales";
import type { Locale } from "@/lib/locales";
import { isTier1 } from "@/lib/locales";
import {
  RefreshCw, Check, AlertCircle, Eye, DollarSign,
  Globe, ChevronDown, ChevronRight, Search, Database,
  Clock, Play, Languages, FileText,
} from "lucide-react";

// ============================================================
// Helper types
// ============================================================
interface LocaleStatus {
  locale: Locale;
  tier: 1 | 2;
  exists: boolean;
  isFullyTranslated: boolean;
  status: "complete" | "summary_only" | "pending" | "not_found";
}

interface ArticleTranslationStatus {
  slug: string;
  title: string;
  locales: LocaleStatus[];
}

// ============================================================
// Build status from articles data (client-safe)
// ============================================================
function buildArticleStatus(master: ArticleMaster): ArticleTranslationStatus {
  const locales: LocaleStatus[] = ALL_LOCALES.map(locale => {
    if (locale === "th") {
      return { locale, tier: 1, exists: true, isFullyTranslated: true, status: "complete" as const };
    }
    // For now, all non-Thai are pending (cache check will be added with DB)
    return {
      locale,
      tier: isTier1(locale) ? 1 : 2,
      exists: false,
      isFullyTranslated: false,
      status: "pending" as const,
    };
  });

  return { slug: master.slug, title: master.originalTitle, locales };
}

// ============================================================
// UI Sections (existing)
// ============================================================
const UI_SECTIONS = [
  { id: "nav", label: "เมนูนำทาง", items: ["หน้าแรก", "มรดกไทย", "ประเพณีไทย", "ภูมิปัญญาไทย", "อาหารไทย", "ภาษาไทย", "ศิลปหัตถกรรม", "ท่องเที่ยว", "เกี่ยวกับ", "ติดต่อเรา"] },
  { id: "hero", label: "Hero Section", items: ["หัวข้อหลัก", "หัวข้อรอง", "ปุ่ม CTA"] },
  { id: "footer", label: "ส่วนท้าย", items: ["ลิงก์", "ข้อมูลติดต่อ", "โซเชียลมีเดีย"] },
  { id: "common", label: "ข้อความทั่วไป", items: ["อ่านเพิ่มเติม", "ดูทั้งหมด", "แบ่งปัน", "คัดลอกลิงก์"] },
];

// ============================================================
// Main Component
// ============================================================
export default function TranslationsPage() {
  const [articles, setArticles] = useState<ArticleMaster[]>([]);
  const [expanded, setExpanded] = useState<Set<string>>(new Set());
  const [search, setSearch] = useState("");
  const [translating, setTranslating] = useState<Set<string>>(new Set());
  const [lastResults, setLastResults] = useState<Map<string, any>>(new Map());
  const [activeTab, setActiveTab] = useState<"articles" | "ui">("articles");

  useEffect(() => {
    const all = getAllArticleMasters().filter(a => a.status === "published" || !a.status);
    setArticles(all);
  }, []);

  const filteredArticles = articles.filter(a =>
    a.originalTitle.toLowerCase().includes(search.toLowerCase()) ||
    a.slug.toLowerCase().includes(search.toLowerCase())
  );

  const toggleExpand = (slug: string) => {
    setExpanded(prev => {
      const next = new Set(prev);
      if (next.has(slug)) next.delete(slug);
      else next.add(slug);
      return next;
    });
  };

  const triggerTranslation = async (slug: string, dryRun: boolean = false) => {
    setTranslating(prev => new Set(prev).add(slug));
    try {
      const res = await fetch("/api/translate-new", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ slug, dryRun }),
      });
      const data = await res.json();
      setLastResults(prev => new Map(prev).set(slug, data));
    } catch (err: any) {
      setLastResults(prev => new Map(prev).set(slug, { error: err.message }));
    } finally {
      setTranslating(prev => {
        const next = new Set(prev);
        next.delete(slug);
        return next;
      });
    }
  };

  const statusInfo = (status: string) => {
    switch (status) {
      case "complete": return { icon: Check, color: "text-emerald-400", label: "สมบูรณ์" };
      case "summary_only": return { icon: Clock, color: "text-amber-400", label: "เฉพาะหัวข้อ" };
      default: return { icon: AlertCircle, color: "text-white/30", label: "รอแปล" };
    }
  };

  return (
    <div className="min-h-screen bg-[#060e1a]">
      {/* Header */}
      <div className="border-b border-white/10 bg-gradient-to-r from-[#0f1f3a] to-[#162545]">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
          <div className="flex items-center justify-between">
            <div>
              <h1 className="text-2xl font-bold text-white flex items-center gap-2">
                <Globe size={24} className="text-amber-400" />
                Translation Manager
              </h1>
              <p className="text-white/40 text-sm mt-1">
                จัดการระบบแปลภาษา 15 ภาษา • Tier 1 (Full) • Tier 2 (Summary + JIT Content)
              </p>
            </div>
            <div className="text-xs text-white/30">
              {articles.length} บทความ • 14 ภาษาที่ต้องแปล
            </div>
          </div>

          {/* Language legend */}
          <div className="mt-4 flex flex-wrap items-center gap-2 text-xs">
            <span className="text-white/40 mr-1">Tier 1:</span>
            {ALL_LOCALES.filter(l => l !== "th" && isTier1(l)).map(l => (
              <span key={l} className="px-2 py-0.5 rounded-full bg-emerald-400/10 text-emerald-300 border border-emerald-400/20">
                {LOCALE_NAMES[l]?.native || l}
              </span>
            ))}
            <span className="text-white/20 mx-1">|</span>
            <span className="text-white/40 mr-1">Tier 2:</span>
            {ALL_LOCALES.filter(l => !isTier1(l)).map(l => (
              <span key={l} className="px-2 py-0.5 rounded-full bg-amber-400/10 text-amber-300/70 border border-amber-400/20">
                {LOCALE_NAMES[l]?.native || l}
              </span>
            ))}
          </div>

          {/* Tabs */}
          <div className="flex gap-1 mt-4 p-1 rounded-lg bg-white/5 border border-white/10 w-fit">
            <button
              onClick={() => setActiveTab("articles")}
              className={`px-4 py-2 rounded-md text-sm transition-all flex items-center gap-1.5 ${activeTab === "articles" ? "bg-amber-300/20 text-amber-300" : "text-white/50 hover:text-white"}`}
            >
              <FileText size={14} />
              บทความ
            </button>
            <button
              onClick={() => setActiveTab("ui")}
              className={`px-4 py-2 rounded-md text-sm transition-all flex items-center gap-1.5 ${activeTab === "ui" ? "bg-amber-300/20 text-amber-300" : "text-white/50 hover:text-white"}`}
            >
              <Languages size={14} />
              ส่วนประกอบ UI
            </button>
          </div>
        </div>
      </div>

      {activeTab === "articles" ? (
        <>
          {/* Search */}
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div className="relative">
              <Search size={14} className="absolute left-3 top-1/2 -translate-y-1/2 text-white/30" />
              <input
                type="text"
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                placeholder="ค้นหาบทความ..."
                className="w-full pl-9 pr-4 py-2 bg-white/5 border border-white/10 rounded-lg text-white text-sm placeholder:text-white/20 focus:outline-none focus:border-amber-400/30"
              />
            </div>
          </div>

          {/* Article List */}
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 space-y-2">
            {filteredArticles.map(article => {
              const status = buildArticleStatus(article);
              const isOpen = expanded.has(article.slug);
              const isTranslating = translating.has(article.slug);
              const result = lastResults.get(article.slug);

              return (
                <div key={article.slug}
                  className="rounded-lg bg-gradient-to-br from-[#0f1f3a] to-[#162545] border border-white/10 overflow-hidden transition-all"
                >
                  {/* Header Row */}
                  <button
                    onClick={() => toggleExpand(article.slug)}
                    className="w-full flex items-center justify-between p-4 hover:bg-white/[0.02] transition-colors text-left"
                  >
                    <div className="flex items-center gap-3 min-w-0">
                      <span className="text-white/30 flex-shrink-0">
                        {isOpen ? <ChevronDown size={14} /> : <ChevronRight size={14} />}
                      </span>
                      <div className="min-w-0">
                        <div className="text-white font-medium text-sm truncate">{article.originalTitle}</div>
                        <div className="text-white/20 text-[10px] mt-0.5">
                          {article.slug} · {article.category}
                        </div>
                      </div>
                    </div>

                    <div className="flex items-center gap-3 flex-shrink-0">
                      {/* Mini status dots */}
                      <div className="hidden sm:flex items-center gap-1">
                        {ALL_LOCALES.filter(l => l !== "th").slice(0, 7).map(l => {
                          const s = status.locales.find(ls => ls.locale === l);
                          const Info = s ? statusInfo(s.status) : null;
                          return (
                            <span
                              key={l}
                              className={`w-2 h-2 rounded-full ${
                                s?.isFullyTranslated ? "bg-emerald-400/60"
                                : s?.status === "summary_only" ? "bg-amber-400/40"
                                : "bg-white/10"
                              }`}
                              title={`${LOCALE_NAMES[l]?.english || l}: ${s?.status || "pending"}`}
                            />
                          );
                        })}
                        <span className="text-white/20 text-[10px] ml-1">+{ALL_LOCALES.length - 8}</span>
                      </div>

                      {/* Actions */}
                      <div className="flex items-center gap-2" onClick={e => e.stopPropagation()}>
                        <button
                          onClick={() => triggerTranslation(article.slug, true)}
                          disabled={isTranslating}
                          className="px-2 py-1 rounded bg-white/5 text-white/30 hover:text-amber-300 text-[10px] border border-white/5 hover:border-amber-400/20 transition-colors"
                          title="Dry Run (ดู cost estimate)"
                        >
                          <Eye size={12} />
                        </button>
                        <button
                          onClick={() => triggerTranslation(article.slug)}
                          disabled={isTranslating}
                          className="flex items-center gap-1 px-2.5 py-1 rounded bg-amber-400/10 text-amber-300 text-[10px] hover:bg-amber-400/20 transition-colors border border-amber-400/20 disabled:opacity-50"
                        >
                          {isTranslating ? (
                            <RefreshCw size={12} className="animate-spin" />
                          ) : (
                            <Play size={12} />
                          )}
                          {isTranslating ? "Translating..." : "Translate"}
                        </button>
                      </div>
                    </div>
                  </button>

                  {/* Expanded: Language grid */}
                  {isOpen && (
                    <div className="border-t border-white/5 p-4 space-y-4">
                      <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2">
                        {ALL_LOCALES.filter(l => l !== "th").map(locale => {
                          const s = status.locales.find(ls => ls.locale === locale);
                          const isT1 = isTier1(locale);
                          const Info = s ? statusInfo(s.status) : null;
                          return (
                            <div
                              key={locale}
                              className={`p-2 rounded-lg border text-xs ${
                                s?.isFullyTranslated ? "bg-emerald-400/5 border-emerald-400/20"
                                : s?.status === "summary_only" ? "bg-amber-400/5 border-amber-400/20"
                                : "bg-white/[0.02] border-white/5"
                              }`}
                            >
                              <div className="flex items-center justify-between mb-1">
                                <span className="text-white font-medium">{LOCALE_NAMES[locale]?.native || locale}</span>
                                <span className={`text-[9px] px-1 py-0.5 rounded ${
                                  isT1 ? "bg-emerald-400/10 text-emerald-400" : "bg-amber-400/10 text-amber-400"
                                }`}>
                                  T{isT1 ? "1" : "2"}
                                </span>
                              </div>
                              <div className="flex items-center gap-1">
                                {Info && <Info.icon size={10} className={Info.color} />}
                                <span className={`${Info?.color || "text-white/30"}`}>
                                  {s?.isFullyTranslated ? "Full" : s?.status === "summary_only" ? "Summary" : "Pending"}
                                </span>
                              </div>
                            </div>
                          );
                        })}
                      </div>

                      {/* Dry Run Results */}
                      {result && (
                        <div className="p-3 rounded-lg bg-white/[0.03] border border-white/5">
                          {result.dryRun ? (
                            <div>
                              <h4 className="text-white/60 text-xs font-medium mb-2 flex items-center gap-1.5">
                                <DollarSign size={12} className="text-amber-400" />
                                Cost Estimate (Dry Run)
                              </h4>
                              <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 text-[10px]">
                                <div>
                                  <span className="text-white/30">Tier 1 API Calls</span>
                                  <div className="text-white font-medium">{result.estimatedCost?.tier1ApiCalls || 4}</div>
                                </div>
                                <div>
                                  <span className="text-white/30">Tier 2 API Calls</span>
                                  <div className="text-white font-medium">{result.estimatedCost?.tier2ApiCalls || 50}</div>
                                </div>
                                <div>
                                  <span className="text-white/30">Total API Calls</span>
                                  <div className="text-amber-300 font-medium">{result.estimatedCost?.totalApiCalls || 54}</div>
                                </div>
                                <div>
                                  <span className="text-white/30">Estimated Cost</span>
                                  <div className="text-emerald-400 font-medium">${(result.estimatedCost?.totalCost || 0.02).toFixed(6)}</div>
                                </div>
                              </div>
                              <div className="mt-2 text-white/20 text-[10px]">
                                * Tier 2 JIT content cost not included (~$0.04/locale on first read via Gemini Pro)
                              </div>
                            </div>
                          ) : result.success ? (
                            <div className="flex items-center gap-2 text-emerald-400 text-xs">
                              <Check size={14} />
                              {result.message || "Translation started successfully"}
                            </div>
                          ) : result.error ? (
                            <div className="flex items-center gap-2 text-red-400 text-xs">
                              <AlertCircle size={14} />
                              Error: {result.error}
                            </div>
                          ) : null}
                        </div>
                      )}
                    </div>
                  )}
                </div>
              );
            })}

            {filteredArticles.length === 0 && (
              <div className="text-center py-12 text-white/30 text-sm">
                <Database size={32} className="mx-auto mb-3 text-white/10" />
                ไม่พบบทความ
              </div>
            )}
          </div>
        </>
      ) : (
        /* UI Sections Translation Tab */
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 pb-12 space-y-4">
          {UI_SECTIONS.map(section => (
            <div key={section.id} className="rounded-xl bg-gradient-to-br from-[#0f1f3a] to-[#162545] border border-white/10 p-5">
              <h3 className="text-white font-semibold mb-3">{section.label}</h3>
              <div className="space-y-2">
                {section.items.map((item, i) => (
                  <div key={i} className="flex items-center justify-between px-3 py-2 rounded-lg bg-white/5 hover:bg-white/10 transition-all">
                    <span className="text-white/70 text-sm">{item}</span>
                    <div className="flex items-center gap-2">
                      <span className="text-white/30 text-xs">TH</span>
                      {ALL_LOCALES.slice(0, 4).map(locale => (
                        <button key={locale} className="text-white/30 hover:text-white text-xs px-1.5 py-0.5 rounded hover:bg-white/10">
                          {locale.toUpperCase()}
                        </button>
                      ))}
                      <ChevronRight size={14} className="text-white/20" />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
